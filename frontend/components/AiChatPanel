"use client";

import { useState } from "react";
import {
  Sparkles,
  Bot,
  Send,
  FileText,
  CheckSquare,
  Languages,
  Wand2,
  HelpCircle,
  Copy,
  Check,
  RefreshCw,
  User,
} from "lucide-react";

interface Message {
  id: string;
  sender: "user" | "ai";
  text: string;
  timestamp: string;
  actionType?: string;
}

const QUICK_ACTIONS = [
  {
    id: "summarize",
    label: "Summarize",
    icon: FileText,
    color: "text-blue-400 bg-blue-500/10 border-blue-500/20 hover:bg-blue-500/20",
  },
  {
    id: "draft-reply",
    label: "Draft Reply",
    icon: Wand2,
    color: "text-purple-400 bg-purple-500/10 border-purple-500/20 hover:bg-purple-500/20",
  },
  {
    id: "action-items",
    label: "Action Items",
    icon: CheckSquare,
    color: "text-emerald-400 bg-emerald-500/10 border-emerald-500/20 hover:bg-emerald-500/20",
  },
  {
    id: "translate",
    label: "Translate",
    icon: Languages,
    color: "text-amber-400 bg-amber-500/10 border-amber-500/20 hover:bg-amber-500/20",
  },
  {
    id: "explain",
    label: "Explain Email",
    icon: HelpCircle,
    color: "text-cyan-400 bg-cyan-500/10 border-cyan-500/20 hover:bg-cyan-500/20",
  },
];

const PRESET_RESPONSES: Record<string, string> = {
  summarize:
    "📌 Summary:\n\n• Sarah Jenkins updated the Q3 roadmap following yesterday's sync.\n• Primary focus shifted to Enterprise AI Copilot features.\n• Key features: Advanced context parsing, custom prompt shortcuts, and Jira/Linear task syncing.\n• Requires review of attached PDF spec prior to Thursday's call.",
  "draft-reply":
    "✉️ Suggested Response:\n\nHi Sarah,\n\nThanks for sharing the updated Q3 roadmap! Realigning toward enterprise AI features makes total sense. I'll review the attached spec today and send over any notes before our call on Thursday.\n\nBest,\nJohn",
  "action-items":
    "✅ Checklist:\n\n1. Review Q3_Roadmap_Draft_v2.pdf\n2. Prepare questions on AI context window constraints for Thursday's call\n3. Confirm timeline for Linear/Jira integration sync",
  translate:
    "🌐 Spanish Translation:\n\nHola John,\n\nHe actualizado el borrador de la hoja de ruta del Q3 según nuestra reunión de ayer. Hemos cambiado nuestro enfoque principal hacia la aceleración de la integración del AI Copilot...",
  explain:
    "💡 Email Context & Intent:\n\n• High priority update from Sarah Jenkins (Head of Product).\n• Intent: Aligning engineering and product priorities around enterprise AI.\n• Action Urgency: Needs your feedback before Thursday.",
};

export default function AIChatPanel() {
  const [messages, setMessages] = useState<Message[]>([
    {
      id: "1",
      sender: "ai",
      text: "Hello John! I'm your email copilot. Click an action below or ask me anything about this email thread.",
      timestamp: "Just now",
    },
  ]);
  const [inputPrompt, setInputPrompt] = useState("");
  const [isGenerating, setIsGenerating] = useState(false);
  const [copiedId, setCopiedId] = useState<string | null>(null);

  const handleQuickAction = (actionId: string, label: string) => {
    if (isGenerating) return;

    const userMsg: Message = {
      id: Date.now().toString(),
      sender: "user",
      text: label,
      timestamp: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }),
      actionType: actionId,
    };

    setMessages((prev) => [...prev, userMsg]);
    setIsGenerating(true);

    setTimeout(() => {
      const responseText =
        PRESET_RESPONSES[actionId] || "I've analyzed the email content for you.";

      const aiMsg: Message = {
        id: (Date.now() + 1).toString(),
        sender: "ai",
        text: responseText,
        timestamp: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }),
      };

      setMessages((prev) => [...prev, aiMsg]);
      setIsGenerating(false);
    }, 750);
  };

  const handleSendMessage = (e: React.FormEvent) => {
    e.preventDefault();
    if (!inputPrompt.trim() || isGenerating) return;

    const userMsg: Message = {
      id: Date.now().toString(),
      sender: "user",
      text: inputPrompt,
      timestamp: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }),
    };

    setMessages((prev) => [...prev, userMsg]);
    const currentInput = inputPrompt;
    setInputPrompt("");
    setIsGenerating(true);

    setTimeout(() => {
      const aiMsg: Message = {
        id: (Date.now() + 1).toString(),
        sender: "ai",
        text: `Based on the thread, regarding "${currentInput}": The sender Sarah expects a response before Thursday's call. All proposed technical specs are linked in the attached PDF.`,
        timestamp: new Date().toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }),
      };

      setMessages((prev) => [...prev, aiMsg]);
      setIsGenerating(false);
    }, 900);
  };

  const handleCopy = (text: string, id: string) => {
    navigator.clipboard.writeText(text);
    setCopiedId(id);
    setTimeout(() => setCopiedId(null), 2000);
  };

  return (
    <aside className="w-80 lg:w-96 h-full bg-[#0F172A] border-l border-slate-800 flex flex-col text-[#F8FAFC] select-none">
      {/* Panel Header */}
      <div className="h-14 px-4 border-b border-slate-800 flex items-center justify-between flex-shrink-0">
        <div className="flex items-center gap-2">
          <div className="p-1.5 bg-blue-600/20 border border-blue-500/30 rounded-lg text-blue-400">
            <Sparkles className="w-4 h-4" />
          </div>
          <h3 className="font-semibold text-sm text-slate-100">AI Assistant</h3>
        </div>
        <span className="text-[11px] bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 px-2 py-0.5 rounded-full font-medium flex items-center gap-1">
          <span className="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-ping" />
          Ready
        </span>
      </div>

      {/* Quick Action Chips Grid */}
      <div className="p-3 border-b border-slate-800/80 bg-[#1E293B]/40">
        <p className="text-[11px] font-semibold text-slate-400 uppercase tracking-wider mb-2">
          Quick Actions
        </p>
        <div className="flex flex-wrap gap-1.5">
          {QUICK_ACTIONS.map((action) => {
            const Icon = action.icon;
            return (
              <button
                key={action.id}
                onClick={() => handleQuickAction(action.id, action.label)}
                disabled={isGenerating}
                className={`flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium border transition-all ${action.color} active:scale-95 disabled:opacity-50`}
              >
                <Icon className="w-3.5 h-3.5" />
                <span>{action.label}</span>
              </button>
            );
          })}
        </div>
      </div>

      {/* Chat Messages Feed */}
      <div className="flex-1 overflow-y-auto p-4 space-y-4 custom-scrollbar">
        {messages.map((msg) => (
          <div
            key={msg.id}
            className={`flex flex-col ${
              msg.sender === "user" ? "items-end" : "items-start"
            }`}
          >
            <div className="flex items-center gap-1.5 mb-1 text-[11px] text-slate-400">
              {msg.sender === "ai" ? (
                <>
                  <Bot className="w-3 h-3 text-blue-400" />
                  <span className="font-medium text-slate-300">Copilot</span>
                </>
              ) : (
                <>
                  <span className="font-medium text-slate-300">You</span>
                  <User className="w-3 h-3 text-slate-400" />
                </>
              )}
              <span>• {msg.timestamp}</span>
            </div>

            <div
              className={`p-3 rounded-2xl text-xs leading-relaxed max-w-[90%] whitespace-pre-line relative group ${
                msg.sender === "user"
                  ? "bg-blue-600 text-white rounded-br-none"
                  : "bg-[#1E293B] border border-slate-700/70 text-slate-200 rounded-bl-none"
              }`}
            >
              {msg.text}

              {msg.sender === "ai" && (
                <button
                  onClick={() => handleCopy(msg.text, msg.id)}
                  className="absolute top-2 right-2 p-1 bg-slate-800/80 hover:bg-slate-700 border border-slate-600/50 rounded text-slate-300 opacity-0 group-hover:opacity-100 transition-opacity"
                  title="Copy output"
                >
                  {copiedId === msg.id ? (
                    <Check className="w-3 h-3 text-emerald-400" />
                  ) : (
                    <Copy className="w-3 h-3" />
                  )}
                </button>
              )}
            </div>
          </div>
        ))}

        {isGenerating && (
          <div className="flex items-center gap-2 text-xs text-blue-400 bg-blue-500/10 border border-blue-500/20 p-2.5 rounded-xl w-max animate-pulse">
            <RefreshCw className="w-3.5 h-3.5 animate-spin" />
            <span>AI is analyzing email context...</span>
          </div>
        )}
      </div>

      {/* Input Prompt Box */}
      <form
        onSubmit={handleSendMessage}
        className="p-3 border-t border-slate-800 bg-[#0F172A] flex items-center gap-2"
      >
        <input
          type="text"
          value={inputPrompt}
          onChange={(e) => setInputPrompt(e.target.value)}
          placeholder="Ask AI about this email..."
          className="flex-1 bg-[#1E293B] text-xs text-slate-200 placeholder-slate-400 px-3 py-2.5 rounded-xl border border-slate-700/60 focus:outline-none focus:border-blue-500 transition-all"
        />
        <button
          type="submit"
          disabled={!inputPrompt.trim() || isGenerating}
          className="p-2.5 bg-blue-600 hover:bg-blue-500 disabled:opacity-50 text-white rounded-xl transition-all active:scale-95 flex-shrink-0"
        >
          <Send className="w-3.5 h-3.5" />
        </button>
      </form>
    </aside>
  );
}
